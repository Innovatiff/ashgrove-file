# Loaded by `next dev` only.
#
# Local development talks to the Firebase Emulator Suite, never to production.
# Start the emulators first: npm run emulators
#
# To point `next dev` at the live project instead, create .env.development.local
# containing NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
