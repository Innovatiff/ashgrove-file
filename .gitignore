# dependencies
/node_modules
/functions/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# cloud functions build output
/functions/lib/

# THE ANSWERS. Codes, hint texts and post-solve evidence live only here and in
# Firestore. Never commit this file. See answers.example.json for the shape.
/answers.json

# service account keys for seeding production
/serviceAccount*.json
/*-firebase-adminsdk-*.json
/.secrets/

# full-size image sources (5 to 30 MB each). See docs/image-prompts.md.
/.image-src/

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
pubsub-debug.log*
database-debug.log*
/.emulator-data/

# env files
# .env.local is tracked on purpose: it holds only the public Firebase web
# config, which ships in the browser bundle anyway. Put anything secret in a
# file matched below.
.env*.local
!.env.local
.env.secret

# testing
/coverage
/test-results/
/playwright-report/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
