{
  "name": "ashgrove-file",
  "version": "0.1.0",
  "private": true,
  "description": "Unsealed, a website of browser-based escape rooms, and its first room, The Ashgrove File.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:emulator": "cross-env NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && firebase emulators:start",
    "emulators:hosting": "npm run functions:build && npm run build:emulator && firebase emulators:start",
    "seed:emulator": "tsx scripts/seed.ts --emulator",
    "seed:prod": "tsx scripts/seed.ts --production",
    "answers:seal": "node scripts/seal-answers.mjs",
    "answers:check": "node scripts/seal-answers.mjs --check",
    "images": "node scripts/process-images.mjs",
    "test": "npm run test:unit && npm run test:rules && npm run test:functions",
    "test:unit": "tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ashgrove \"tsx --test --test-reporter=spec tests/rules/*.test.ts\"",
    "test:functions": "npm run functions:build && firebase emulators:exec --only auth,firestore,functions --project demo-ashgrove \"tsx --test --test-reporter=spec tests/functions/*.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.36.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
